PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ecotrace
JWT_SECRET=replace_with_a_secure_random_secret
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=development-private-key-from-hardhat-node
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
FRONTEND_URL=http://localhost:5173

# Optional: QpiAI Opt Optimization Engine (Quantum/AI Logistics & Route Planner)
# Leave empty if not using QpiAI; application remains 100% functional with local heuristic planner
QPIAI_OPT_API_KEY=

# Optional: Custom self-hosted or dedicated OSRM routing endpoint (defaults to public https://router.project-osrm.org)
# No Google Maps billing or API keys required!
OSRM_ROUTING_URL=https://router.project-osrm.org
